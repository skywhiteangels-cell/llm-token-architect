# Session exports (personal transcripts, regenerated by tools/export_session.py)
# Транскрипты (.jsonl) не публикуются. Игнорируется содержимое каталога, а не сам
# каталог: иначе git не спустится внутрь и правило ниже не сработает.
# Публикуется ровно один паспорт — тот, по которому сверяются числа досье
# (16/86 повреждённых чанков, 5 840 записей). Остальные выгрузки остаются локально.
exports/*
!exports/77556605-b3a9-42b8-8624-ff84cb296321.meta.json
